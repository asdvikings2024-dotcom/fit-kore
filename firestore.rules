rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  match /admins/{uid} {
   allow read: if admin() && request.auth.uid == uid;
   allow write: if false;
  }
  match /members/{uid} {
   allow read: if admin() || (signedIn() && request.auth.uid == uid);
   allow create: if signedIn() && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['email','status','createdAt'])
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time;
   allow update: if admin()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
      && request.resource.data.status in ['approved','rejected']
      && request.resource.data.reviewedAt == request.time;
   allow delete: if false;
  }
  function approved() { return signedIn() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved'; }
  // Dati personali dell'app: solo il proprietario, e solo se approvato (o amministratore).
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid && (admin() || approved());
   allow write: if signedIn() && request.auth.uid == uid && (admin() || approved())
      && request.resource.data.keys().hasOnly(['data','rev','updatedAt'])
      && request.resource.data.data is map
      && request.resource.data.data.size() <= 40
      && request.resource.data.rev is int
      && request.resource.data.updatedAt == request.time;
  }
  match /{document=**} { allow read, write: if false; }
 }
}